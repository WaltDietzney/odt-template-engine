{
    "name": "waltdietzney/odt-template-engine",
    "description": "A PHP template engine for generating editable OpenDocument Text (ODT) files with variables, conditions, loops, images, rich text, tables and styles.",
    "keywords": [
        "odt",
        "opendocument",
        "template",
        "document-generation",
        "libreoffice",
        "office",
        "php"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Walter Dietz"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "OdtTemplateEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OdtTemplateEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "archive": {
        "exclude": [
            "/demo",
            "/docker",
            "/output",
            "/qrcode",
            "/tests"
        ]
    },
    "support": {
        "issues": "https://github.com/WaltDietzney/odt-template-engine/issues",
        "source": "https://github.com/WaltDietzney/odt-template-engine"
    }
}
