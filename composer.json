{
    "name": "waltdietzney/odt-template-engine",
    "description": "A lightweight PHP template engine for generating and manipulating OpenDocument Text (ODT) files.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Walter Dietz"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-zip": "*"
    },
    "autoload": {
        "psr-4": {
            "OdtTemplateEngine\\": "src/"
        }
    },
    "archive": {
        "exclude": [
            "/demo",
            "/docker",
            "/output",
            "/qrcode"
        ]
    },
    "support": {
        "issues": "https://github.com/WaltDietzney/odt-template-engine/issues",
        "source": "https://github.com/WaltDietzney/odt-template-engine"
    }
}
